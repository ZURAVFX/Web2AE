{
  "manifest_version": 3,
  "name": "Web2AE — Live Web to After Effects",
  "version": "1.0.0",
  "description": "Send the current live webpage to After Effects as editable text, shapes and image layers. Local-only and open source.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:17321/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Send webpage to After Effects",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web2ae@zura.tools",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  }
}
